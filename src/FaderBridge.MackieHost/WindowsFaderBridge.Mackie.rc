#include <windows.h>
#include "../BridgeProductVersion.h"
1 ICON "assets/WindowsFaderBridge.Mackie.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION BRIDGE_PRODUCT_VERSION_COMMA
 PRODUCTVERSION BRIDGE_PRODUCT_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Lindelea\0"
   VALUE "FileDescription", "Windows Fader Bridge for Mackie Control\0"
   VALUE "FileVersion", BRIDGE_PRODUCT_VERSION_TEXT
   VALUE "OriginalFilename", "WindowsFaderBridge.Mackie.exe\0"
   VALUE "ProductName", "Windows Fader Bridge for Mackie Control\0"
   VALUE "ProductVersion", BRIDGE_PRODUCT_VERSION_TEXT
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
